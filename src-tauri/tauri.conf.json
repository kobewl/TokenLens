{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenLens",
  "version": "0.4.0",
  "identifier": "app.tokenlens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TokenLens",
        "width": 1180,
        "height": 860,
        "backgroundColor": "#ffffff",
        "minWidth": 880,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kobewl/TokenLens/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDQTIxNjc3QkJCRDlBMTYKUldRV21yMjdkeGFpbkVkN3hnRjZMZ0ROTzVNdzN5TnRrNWROd1kyNEhNU1NsKytoM2phd0F3UEMK",
      "requireSignedVersion": true
    }
  }
}
